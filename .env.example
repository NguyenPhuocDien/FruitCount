# Copy to .env only if you want to override these defaults.
FRUITCOUNT_PORT=3000
# 0.0.0.0 allows other devices on the LAN; 127.0.0.1 restricts to this machine.
FRUITCOUNT_BIND_ADDRESS=0.0.0.0
# Relative paths are resolved from compose.yaml. Forward slashes work on Windows.
FRUITCOUNT_MODELS_DIR="./backend FruitCount"
# true adds TensorFlow CPU support for .h5/.keras/.tflite (larger image).
INSTALL_TENSORFLOW=false
